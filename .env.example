# One inference provider key is required for real LLM mutations. Without any,
# run_evolution.py falls back to the deterministic analytical simulator.
# When several are set, the first of Crusoe, OpenRouter, Vultr wins unless
# --provider / LLM_PROVIDER says otherwise.

# Crusoe Intelligence Foundry (console: Admin -> Security -> Intelligence API keys)
CRUSOE_API_KEY="..."

# OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY="sk-or-v1-..."

# Vultr Serverless Inference (https://my.vultr.com -> Serverless Inference -> API key)
# VULTR_SERVERLESS_INFERENCE_API_KEY="..."

# Optional: pin the provider instead of auto-detecting from the keys above
# LLM_PROVIDER=crusoe

# Optional: Crusoe model (default: deepseek-ai/Deepseek-V4-Flash; `python run_evolution.py --list-models crusoe`).
# NVIDIA Nemotron, e.g. nvidia/Nemotron-3.5-Lightning-30B-A3B or nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
# CRUSOE_MODEL="nvidia/Nemotron-3.5-Lightning-30B-A3B"
# Optional: output budget for any provider (Crusoe and Vultr default to 32768, OpenRouter to 8192)
# LLM_MAX_TOKENS=32768

# Optional: override the OpenRouter mutation model (default: largest free Liquid model)
# LIQUID_MODEL="liquid/lfm-2.5-2.6b:free"
# Optional: Vultr model (default: glm-5.3; `python run_evolution.py --list-models vultr`)
# VULTR_MODEL="glm-5.3"
# Optional: thinking budget for Vultr (default: low). glm-5.3 at "high" spends the whole
# output budget on reasoning for the mutation prompt and returns no JSON.
# VULTR_REASONING_EFFORT=low

# Optional: Nimble web search for --web-seed (https://online.nimbleway.com)
# NIMBLE_API_KEY="..."

# Optional: output budget and reasoning effort for the Liquid model
# LIQUID_MAX_TOKENS=8192
# LIQUID_REASONING_EFFORT=high

# Optional: persistent feedback memory, including real GPU timings.
# FEEDBACK_MEMORY=file keeps them in .kerngen_memory.jsonl next to the script:
# FEEDBACK_MEMORY=file
# FEEDBACK_FILE=.kerngen_memory.jsonl

# Optional: persistent feedback memory in RawTree (--feedback-memory rawtree), https://rawtree.com
# Key with read_write permission: `rtree key create --name kerngen --permission read_write`
# RAWTREE_API_KEY="rt_..."
# RAWTREE_DATABASE="default"
# RAWTREE_FEEDBACK_TABLE="kerngen_feedback"
# FEEDBACK_MEMORY=rawtree

# Optional: run every Nth generation on a real GPU (same as --gpu-bench-every)
# GPU_BENCH_EVERY=3
